<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
      <PackageReference Include="NativeFileDialogSharp" Version="0.5.0" />
      <PackageReference Include="OpenTK" Version="4.9.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MadEngine.Core\MadEngine.Core.csproj" />
    </ItemGroup>

    <Target Name="CopyRuntimeTemplate" AfterTargets="Build">
        <PropertyGroup>
            <RuntimeProjectPath>$(ProjectDir)..\MadEngine.Runtime\MadEngine.Runtime.csproj</RuntimeProjectPath>
            <RuntimeTargetDir>$(TargetDir)runtime\</RuntimeTargetDir>
        </PropertyGroup>

        <Message Text="====== Building and deploying MadEngine.Runtime Template ======" Importance="high" />
        
        <MSBuild Projects="$(RuntimeProjectPath)"
                 Properties="Configuration=$(Configuration);Platform=$(Platform)"
                 Targets="Build" />
        
        <ItemGroup>
            <RuntimeFiles Include="$(ProjectDir)..\MadEngine.Runtime\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
        </ItemGroup>
        
        <Copy SourceFiles="@(RuntimeFiles)"
              DestinationFolder="$(RuntimeTargetDir)%(RecursiveDir)"
              SkipUnchangedFiles="true" />

        <Message Text="====== Runtime Template successfully deployed to $(RuntimeTargetDir) ======" Importance="high" />
    </Target>


    <ItemGroup>
      <None Remove="Shaders\lamp.frag" />
      <None Remove="Shaders\shader.frag" />
      <None Remove="Shaders\shader.vert" />
      <Content Update="Shaders\unlit.vert">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="package.pck" />
      <Content Include="package.pck">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <None Remove="packages.json" />
      <Content Include="packages.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <None Remove="Shaders\lit.frag" />
      <Content Include="Shaders\lit.frag">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Shaders\lit.vert" />
      <Content Include="Shaders\lit.vert">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Shaders\unlit.frag" />
      <Content Include="Shaders\unlit.frag">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Shaders\unlit.vert" />
      <Content Include="Shaders\unlit.vert">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Textures\skybox.png" />
    </ItemGroup>

</Project>
